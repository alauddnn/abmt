# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Supabase PostgreSQL Connection String (Transaction Pooler port 6543)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# SUPABASE CLIENT (Google OAuth 2.0 via Supabase Auth)
# URL project Supabase Anda (misal: https://wrphgazcvapjbwlaryny.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# Anon public key dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CLOUDFLARE TURNSTILE (Bot Verification)
# Site Key (Frontend) dari Cloudflare Dashboard -> Turnstile -> Add Site
# Testing key default (selalu lolos): 1x00000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Secret Key (Backend Only - Jangan dipublikasikan ke frontend)
# Testing secret key default (selalu lolos): 1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
